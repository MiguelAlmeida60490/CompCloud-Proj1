# Build output
target/
*.class
*.log

# Package files
*.jar
*.zip

# Azure Functions.
#
# local.settings.json holds the connection strings you use when running locally with
# "func start". It is given to you empty; once you put keys in it, do not commit it.
local.settings.json
bin/
obj/

# Terraform. terraform.tfstate holds the database and storage keys in clear text once you
# have run apply, so it must never be committed. .terraform.lock.hcl is generated by
# "terraform init", so it is not committed either. terraform.tfvars is your own suffix and
# region.
.terraform/
.terraform.lock.hcl
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
terraform.tfvars

# IDE
.idea/
*.iml
.settings/
.project
.classpath
.vscode/

# macOS
.DS_Store
Icon?

# Written by "terraform apply" with your app names - see the end of main.tf.
.mvn/
